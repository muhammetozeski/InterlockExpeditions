@page "/room/{RoomId}"
@inherits LiveExpeditionPage
@inject IJSRuntime Javascript
@inject NavigationManager Navigation
<PageTitle>@(Current?.Room.Title ?? "Join a crew") — Interlock Expeditions</PageTitle>
@if (Status.Length > 0) { <p class="status @(HasError ? "error" : "")" role="status">@Status</p> }
@if (StorageWarning.Length > 0) { <p class="notice">@StorageWarning</p> }
@if (Current is null)
{
    <p class="eyebrow">Private expedition invitation</p><h1>Join the other half.</h1><p>Use the host's room code and choose a crew. Keep the two crew cards on separate devices for the puzzle experience.</p><section class="panel"><fieldset disabled="@Busy"><label>Invitation code<input @bind="Code" maxlength="8" autocomplete="off" /></label><label>Your display alias<input @bind="Alias" maxlength="40" autocomplete="nickname" /></label><label>Crew<select @bind="Role"><option value="signal">Signal crew · manuals and signals</option><option value="engine">Machine crew · dials and trolley</option></select></label><button class="primary" @onclick="JoinAsync" disabled="@(Code.Length != 8 || string.IsNullOrWhiteSpace(Alias))">Join this real room</button><button @onclick="RestoreAsync" disabled="@(Module is null)">Restore this device's player</button></fieldset><p class="small">You do not need a host account. A private room-player capability is stored only on this device; it is never part of the invitation.</p></section>
}
else
{
    <div class="row"><div><span class="badge @Current.Player.Role">@(Current.Player.Role == "signal" ? "SIGNAL DESK" : "MACHINE DESK")</span><h1>@Current.Room.Title</h1><p>@Current.EpisodeTitle · playing as @Current.Player.Alias</p></div><strong class="clock" aria-label="Room time remaining">@Clock(Current.Room)</strong></div>
    <div class="station-progress" aria-label="@($"{Math.Min(Current.Room.StageIndex, Current.StageCount)} of {Current.StageCount} stations complete")">@for (var index = 0; index < Current.StageCount; index++) { <span class="@(index < Current.Room.StageIndex ? "done" : index == Current.Room.StageIndex ? "current" : "")"></span> }</div>
    <ul class="crew-list">@foreach (var player in Current.Players) { <li><strong>@player.Alias</strong> · @(player.Role == "signal" ? "signal" : "machine") @if (Current.Room.ServerNow - player.SeenAt > 90000) { <span>· not seen recently</span> }</li> }</ul>
    @if (Current.Room.Status == "lobby") { <section class="panel"><h2>Both crews meet here.</h2><p>@Current.Introduction</p><p>Waiting for the host to start. At least one real guest must join each crew. Speak in person or on your usual call; this site does not record your microphone.</p><a class="button" href="@("/control/" + RoomId)">Host controls · owner access required</a></section> }
    else if (Current.Room.Status == "finished") { <section class="ending"><p class="eyebrow">@Current.Room.Outcome</p><h2>@(Current.Room.Outcome == "escaped" ? "Both crews made it." : Current.Room.Outcome == "timeout" ? "The room clock reached zero." : "The host ended this room.")</h2><p>@Current.Ending</p><p>@Math.Min(Current.Room.StageIndex, Current.StageCount) stations completed · @Current.Room.Mistakes recorded mistakes.</p><p>Your room record remains available until the host erases it. A new expedition uses a separate room.</p><a class="button primary" href="/">Choose the next expedition</a></section> }
    else if (Current.Station is { } station)
    {
        @if (Current.Room.Status == "paused") { <p class="notice">The host paused the clock and machine controls. Your settings and readiness windows are kept.</p> }
        <h2>@station.Title</h2><p>@station.Scene</p><div class="console-grid"><section class="role-card @Current.Player.Role"><p class="eyebrow">Only your crew's card</p><h3>Read. Explain. Coordinate.</h3><p>@station.Clue</p><details><summary>Open a station-specific hint</summary><p>@station.Hint</p></details><p class="small">Changing a machine setting clears both check marks. The server advances only when both crews have checked a valid objective.</p></section><section class="machine"><StationConsole Station="station" Role="Current.Player.Role" Disabled="@(Busy || Current.Room.Status != "active")" EffectiveClock="@(Current.Room.Status == "paused" ? Current.Room.PausedAt ?? ServerClock : ServerClock)" Send="SendAsync" /></section></div>
    }
    <div class="toolbar"><button @onclick="RefreshAsync" disabled="@Busy">Read current room state</button><span class="small">Shared progress refreshes every few seconds. Only the server advances a station.</span></div>
    <details><summary>Recent real room events</summary><ul class="event-log">@foreach (var item in Current.Events) { <li>@item.Message</li> }</ul></details><details><summary>Report a room problem</summary><label>Reason<select @bind="ReportReason"><option value="broken">Broken game behavior</option><option value="unsafe">Unsafe or abusive aliases</option><option value="privacy">Privacy concern</option><option value="spam">Spam</option></select></label><label>Details<textarea @bind="ReportNote" maxlength="900" rows="2"></textarea></label><button @onclick="ReportAsync" disabled="@Busy">Send report</button></details>
}
@code {
    [Parameter] public string RoomId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "invite")] public string? Invitation { get; set; }
    [SupplyParameterFromQuery(Name = "crew")] public string? PreferredCrew { get; set; }
    PlayState? Current; PlayerIdentity? Identity; IJSObjectReference? Module; string Code = "", Alias = "", Role = "signal", ReportReason = "broken", ReportNote = "", StorageWarning = ""; string? LoadedRoom; bool NeedsRestore;
    protected override void OnParametersSet() { if (LoadedRoom != RoomId) { LoadedRoom = RoomId; Current = null; Identity = null; Code = Invitation ?? ""; Role = PreferredCrew is "signal" or "engine" ? PreferredCrew : "signal"; NeedsRestore = Module is not null; } }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first) { await RunAsync(async () => { try { Module = await Javascript.InvokeAsync<IJSObjectReference>("import", "/assets/device.js"); } catch (JSException) { StorageWarning = "Private device storage is unavailable. Keep this tab open while playing."; } await RestoreCoreAsync(); }); StateHasChanged(); }
        else if (NeedsRestore && !Busy) { NeedsRestore = false; await RunAsync(RestoreCoreAsync); StateHasChanged(); }
    }
    async Task RestoreCoreAsync()
    {
        if (Module is not null) { try { Identity = await Module.InvokeAsync<PlayerIdentity?>("player", RoomId); } catch (JSException) { Identity = null; StorageWarning = "The device's saved player could not be read. The service will try this browser's private cookie instead."; } }
        try { await ApplyAsync(await Api.PlayAsync(RoomId, Identity, Lifetime.Token)); Status = "Your authorized crew state was restored."; }
        catch (ExpeditionFailure error) when (error.Status is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.NotFound) { Current = null; Identity = null; Status = "Enter this room's invitation to join, or ask the host for the current code."; }
    }
    async Task ApplyAsync(PlayState incoming)
    {
        if (incoming.Room.Id != RoomId || Current is not null && incoming.Room.Id == Current.Room.Id && incoming.Room.Revision < Current.Room.Revision) return;
        Current = incoming; ObserveClock(incoming.Room); Identity = new() { RoomId = incoming.Room.Id, Id = incoming.Player.Id, Key = incoming.PlayerKey };
        if (Module is not null) { try { await Module.InvokeVoidAsync("rememberPlayer", RoomId, Identity); } catch (JSException error) { Logger.LogWarning("Player device save failed; type={Type}", error.GetType().Name); StorageWarning = "Your player is active, but this browser could not save its recovery capability. Keep this tab open."; } }
        Watch(ReloadAsync, () => Current?.Room.Status == "finished");
    }
    async Task ReloadAsync() { if (Identity is not null) await ApplyAsync(await Api.PlayAsync(RoomId, Identity, Lifetime.Token)); }
    Task RestoreAsync() => RunAsync(RestoreCoreAsync);
    Task RefreshAsync() => RunAsync(ReloadAsync);
    Task JoinAsync() => RunAsync(async () => { await ApplyAsync(await Api.JoinAsync(RoomId, Code, Alias, Role)); Status = "Joined the real room. Keep your private crew card on this device."; });
    Task SendAsync(object action) => RunAsync(async () => { if (Current?.Station is not { } station || Identity is null) return; var requestedRoom = RoomId; var result = await Api.ActAsync(requestedRoom, station.Id, action, Identity); if (requestedRoom != RoomId) return; await ApplyAsync(result); HasError = false; Status = Current?.Room.Outcome == "escaped" ? "Expedition completed by both crews." : "Your control was applied to the shared machine."; });
    Task ReportAsync() => RunAsync(async () => { if (Identity is null) return; await Api.ReportAsync(RoomId, ReportReason, ReportNote, Identity); ReportNote = ""; Status = "Room report submitted."; });
    protected override async ValueTask DisposeBrowserAsync() { if (Module is not null) await Module.DisposeAsync(); }
}
