@page "/membership"
@inherits ExpeditionPage
@inject NavigationManager Navigation
<PageTitle>Host allowances — Interlock Expeditions</PageTitle>
<h1>Host allowances</h1><p>All stories are free. Larger groups can use Club when subscriptions are available.</p>
@if (Status.Length > 0) { <p class="status @(HasError ? "error" : "")" role="status">@Status</p> }
<div class="split"><section class="panel"><h2>Free</h2><ul><li>Two active rooms</li><li>Six devices per room, split between the crews</li><li>All six stories, pause and reconnect</li></ul><a class="button primary" href="host">Host a room</a></section><section class="panel"><h2>Club</h2>
@if (!Loaded) { <p>@(Busy ? "Loading availability." : "Refresh to check availability.")</p> }
else
{
    @if (Current.Configured || Current.Premium) { <ul><li>Twelve active rooms</li><li>Twelve devices per new room</li></ul> }
    @if (Current.Premium) { <p class="notice">Active through @EndDate.</p> }
    @if (Current.Subscription is not null) { <p>Subscription: <strong>@Current.Subscription.Status</strong>.</p> }
    @if (!Current.Configured) { <p class="notice">Subscriptions are unavailable. Every story remains free.</p> }
    else if (!Current.SignedIn) { <a class="button" href="account">Sign in to subscribe</a> }
    else
    {
        @if (!Current.Premium) { <p>You'll see the price before confirming payment.</p><button class="primary" @onclick="CheckoutAsync" disabled="@Busy">Continue to checkout</button> }
        @if (Current.Subscription is not null) { <button @onclick="ManageAsync" disabled="@Busy">Manage or cancel</button> }
    }
}
</section></div><button @onclick="RefreshAsync" disabled="@Busy">Refresh status</button>
<details><summary>Payment and cancellation</summary><p>After checkout, refresh to check your membership. Existing rooms keep their original device limit; larger limits apply to new rooms.</p><p>Cancelling renewal keeps access through the paid period. Current-period refunds or disputes remove Club capacity. An open checkout can block account deletion until it expires.</p><p>Your recovery key protects billing access too. Keep it private. Guests never need a subscription.</p></details>
@code {
    BillingStatus Current = new(); bool Loaded;
    string EndDate => Current.Subscription?.ExpiresAt > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(Current.Subscription.ExpiresAt).UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") : "the recorded paid period";
    protected override Task OnInitializedAsync() => RefreshAsync();
    Task RefreshAsync() => RunAsync(async () => { Current = await Api.BillingAsync(); Loaded = true; Status = ""; });
    Task CheckoutAsync() => RunAsync(async () => { var result = await Api.CheckoutAsync(); Go(result.Url, "checkout.stripe.com"); });
    Task ManageAsync() => RunAsync(async () => { var result = await Api.BillingPortalAsync(); Go(result.Url, "billing.stripe.com"); });
    void Go(string address, string host) { if (!Uri.TryCreate(address, UriKind.Absolute, out var url) || url.Scheme != "https" || url.Host != host) throw new FormatException("The payment destination was not accepted."); Navigation.NavigateTo(address, forceLoad: true); }
}
