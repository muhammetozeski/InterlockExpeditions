@page "/control/{RoomId}"
@inherits LiveExpeditionPage
@inject NavigationManager Navigation
@inject IJSRuntime Javascript
<PageTitle>Room controls — Interlock Expeditions</PageTitle>
<h1>@(Current?.Room.Title ?? "Room controls")</h1>
@if (Status.Length > 0) { <p class="status @(HasError ? "error" : "")" role="status">@Status</p> }
@if (ConnectionWarning.Length > 0) { <p class="notice" role="status">@ConnectionWarning</p> }
@if (Current is not null)
{
    <div class="row"><div><span class="badge">@Current.Room.Status</span><p>@Current.EpisodeTitle · @Current.CurrentStation</p></div><strong class="clock">@Clock(Current.Room)</strong></div>
    <div class="split"><section class="panel"><h2>Invite players</h2><p>Send this link to the other device. Guests do not need an account.</p><label>Invitation link<input readonly value="@JoinLink" /></label><button @onclick='CopyAsync' disabled="@(Busy || Module is null)">Copy invitation</button><div class="toolbar"><a class="button primary" href="@(JoinLink + "&crew=engine")" target="_blank" rel="noopener">Play as machine crew</a><a class="button" href="@(JoinLink + "&crew=signal")" target="_blank" rel="noopener">Play as signal crew</a></div><details><summary>Replace the invitation</summary><p>The old link will stop accepting new players. Players already in the room keep their access.</p><button @onclick='() => CommandAsync("rotate")' disabled="@Busy">Replace invitation</button></details></section>
    <section class="panel"><h2>Room controls</h2><p>@Current.Players.Count / @Current.Room.Capacity players joined. @if (!BothCrews && Current.Room.Status == "lobby") { <span>At least one player must join each crew to start.</span> }</p><div class="toolbar">@if (Current.Room.Status == "lobby") { <button class="primary" @onclick='() => CommandAsync("start")' disabled="@(Busy || !BothCrews)">Start adventure</button> }@if (Current.Room.Status == "active") { <button @onclick='() => CommandAsync("pause")' disabled="@Busy">Pause</button> }@if (Current.Room.Status == "paused") { <button class="primary" @onclick='() => CommandAsync("resume")' disabled="@Busy">Resume</button> }<button @onclick='RefreshAsync' disabled="@Busy">Refresh</button></div>@if (Current.Room.Status is "active" or "paused") { <details><summary>Restart this puzzle</summary><p>Clears this puzzle's settings and adds one mistake, costing five seconds.</p><button @onclick='() => CommandAsync("reset")' disabled="@Busy">Restart puzzle</button></details> }<p>Mistakes: <strong>@Current.Room.Mistakes</strong></p>@if (Current.Room.Status != "finished") { <details><summary>End the adventure</summary><label class="inline"><input type="checkbox" @bind="EndConfirmed" /> End this adventure for everyone</label><button class="danger" @onclick='() => CommandAsync("end")' disabled="@(Busy || !EndConfirmed)">End room</button></details> } else { <p>Outcome: <strong>@Current.Room.Outcome</strong></p> }</section></div>
    <section class="panel"><h2>Players</h2>@if (Current.Players.Count == 0) { <p>No players yet.</p> }@foreach (var player in Current.Players) { <div class="row"><p><span class="badge @player.Role">@(player.Role == "signal" ? "SIGNAL" : "MACHINE")</span> @player.Alias <small>· last seen @DateTimeOffset.FromUnixTimeMilliseconds(player.SeenAt).ToString("HH:mm:ss 'UTC'")</small></p><button class="danger" @onclick='() => KickAsync(player.Id)' disabled="@Busy">Remove player</button></div> }</section>
    <details><summary>Room activity</summary><ul class="event-log">@foreach (var item in Current.Events) { <li>@item.Message</li> }</ul></details>
    @if (Current.Room.Status == "finished") { <details><summary>Erase this ended room</summary><p>This deletes its crew identities, progress and event records. It does not affect another room or the authored episode.</p><label>Type DELETE THIS ROOM<input @bind="Deletion" autocomplete="off" /></label><button class="danger" @onclick='DeleteAsync' disabled="@(Busy || Deletion != "DELETE THIS ROOM")">Erase ended room</button></details> }
}
else if (Busy) { <p>Opening room controls.</p> }
else { <p><a href="/account">Sign in with the account that created this room</a>.</p> }
@code {
    [Parameter] public string RoomId { get; set; } = "";
    RoomControl? Current; IJSObjectReference? Module; string Deletion = ""; string? LoadedRoom; bool EndConfirmed, NeedsReload;
    bool BothCrews => Current?.Players.Any(player => player.Role == "signal") == true && Current.Players.Any(player => player.Role == "engine");
    string JoinLink => Navigation.BaseUri.TrimEnd('/') + "/room/" + RoomId + "?invite=" + Current?.Invitation;
    protected override async Task OnParametersSetAsync() { if (LoadedRoom != RoomId) { LoadedRoom = RoomId; Current = null; EndConfirmed = false; Deletion = ""; } if (Busy) { NeedsReload = true; return; } await RunAsync(async () => { Apply(await Api.ControlAsync(RoomId, Lifetime.Token)); Watch(ReloadAsync, () => Current?.Room.Status == "finished"); }); }
    protected override async Task OnAfterRenderAsync(bool first) { if (first) { try { Module = await Javascript.InvokeAsync<IJSObjectReference>("import", "/assets/device.js"); } catch (JSException) { Status = "Clipboard access is unavailable. Copy the invitation from its visible field."; } StateHasChanged(); } if (NeedsReload && !Busy) { NeedsReload = false; await RunAsync(async () => { await ReloadAsync(); Watch(ReloadAsync, () => Current?.Room.Status == "finished"); }); StateHasChanged(); } }
    void Apply(RoomControl incoming) { if (incoming.Room.Id != RoomId) return; if (Current is null || incoming.Room.Id != Current.Room.Id || incoming.Room.Revision >= Current.Room.Revision) { Current = incoming; ObserveClock(incoming.Room); } }
    async Task ReloadAsync() => Apply(await Api.ControlAsync(RoomId, Lifetime.Token));
    Task RefreshAsync() => RunAsync(async () => { await ReloadAsync(); ConnectionWarning = ""; });
    Task CommandAsync(string type) => RunAsync(async () => { var requestedRoom = RoomId; var result = await Api.HostAsync(requestedRoom, type); if (requestedRoom != RoomId) return; Apply(result); Status = type == "rotate" ? "New invitation ready. Copy it to invite players." : ""; EndConfirmed = false; });
    Task KickAsync(string id) => RunAsync(async () => { var requestedRoom = RoomId; var result = await Api.HostAsync(requestedRoom, "kick", id); if (requestedRoom != RoomId) return; Apply(result); Status = "Player removed."; });
    Task CopyAsync() => RunAsync(async () => { if (Module is not null) Status = await Module.InvokeAsync<bool>("copy", JoinLink) ? "Room invitation copied." : "Copy the invitation from its visible field."; });
    Task DeleteAsync() => RunAsync(async () => { await Api.DeleteRoomAsync(RoomId, Deletion); Navigation.NavigateTo("/host"); });
    protected override async ValueTask DisposeBrowserAsync() { if (Module is not null) await Module.DisposeAsync(); }
}

