@page "/control/{RoomId}"
@inherits LiveExpeditionPage
@inject NavigationManager Navigation
@inject IJSRuntime Javascript
<PageTitle>Room controls — Interlock Expeditions</PageTitle>
<p class="eyebrow">Host console · private account access</p><h1>@(Current?.Room.Title ?? "Read your room controls")</h1>
@if (Status.Length > 0) { <p class="status @(HasError ? "error" : "")" role="status">@Status</p> }
@if (Current is not null)
{
    <div class="row"><div><span class="badge">@Current.Room.Status</span><p>@Current.EpisodeTitle · @Current.CurrentStation</p></div><strong class="clock">@Clock(Current.Room)</strong></div>
    <div class="split"><section class="panel"><h2>1. Invite the crews</h2><p>Open one crew console on this device and send the other invitation to someone you can talk to. Each player chooses a display alias; guests need no host account.</p><label>Room invitation<input readonly value="@JoinLink" /></label><button @onclick='CopyAsync' disabled="@(Busy || Module is null)">Copy invitation</button><div class="toolbar"><a class="button primary" href="@(JoinLink + "&crew=engine")" target="_blank" rel="noopener">Open machine crew console</a><a class="button" href="@(JoinLink + "&crew=signal")" target="_blank" rel="noopener">Open signal crew console</a></div><p class="small">Do not send account recovery keys or private player capabilities. This address contains only the room invitation.</p><button @onclick='() => CommandAsync("rotate")' disabled="@Busy">Replace invitation code</button></section>
    <section class="panel"><h2>2. Run the expedition</h2><p>@Current.Players.Count / @Current.Room.Capacity actual guest devices joined. Both crews need at least one player before start. A crew can include several people sharing its instructions.</p><div class="toolbar">@if (Current.Room.Status == "lobby") { <button class="primary" @onclick='() => CommandAsync("start")' disabled="@(Busy || !BothCrews)">Start with both crews</button> }@if (Current.Room.Status == "active") { <button @onclick='() => CommandAsync("pause")' disabled="@Busy">Pause clock and machines</button> }@if (Current.Room.Status == "paused") { <button class="primary" @onclick='() => CommandAsync("resume")' disabled="@Busy">Resume expedition</button> }<button @onclick='RefreshAsync' disabled="@Busy">Refresh real room state</button></div><p class="small">A mistake removes five seconds. Resetting the current station adds one mistake. Pause preserves both the room clock and armed-terminal windows.</p>@if (Current.Room.Status is "active" or "paused") { <button @onclick='() => CommandAsync("reset")' disabled="@Busy">Reset current station · one mistake</button> }<p>Current mistakes: <strong>@Current.Room.Mistakes</strong></p>@if (Current.Room.Status != "finished") { <details><summary>End this room without completing it</summary><label class="inline"><input type="checkbox" @bind="EndConfirmed" /> End this expedition for all crews</label><button class="danger" @onclick='() => CommandAsync("end")' disabled="@(Busy || !EndConfirmed)">End room</button></details> } else { <p>Recorded outcome: <strong>@Current.Room.Outcome</strong></p> }</section></div>
    <section class="panel"><h2>Actual crew roster</h2>@if (Current.Players.Count == 0) { <p>Nobody has joined this room yet.</p> }@foreach (var player in Current.Players) { <div class="row"><p><span class="badge @player.Role">@(player.Role == "signal" ? "SIGNAL" : "MACHINE")</span> @player.Alias <small>· last seen @DateTimeOffset.FromUnixTimeMilliseconds(player.SeenAt).ToString("HH:mm:ss 'UTC'")</small></p><button class="danger" @onclick='() => KickAsync(player.Id)' disabled="@Busy">Remove this player</button></div> }</section>
    <section class="panel"><h2>Room events</h2><ul class="event-log">@foreach (var item in Current.Events) { <li>@item.Message</li> }</ul></section>
    @if (Current.Room.Status == "finished") { <details><summary>Erase this ended room</summary><p>This deletes its crew identities, progress and event records. It does not affect another room or the authored episode.</p><label>Type DELETE THIS ROOM<input @bind="Deletion" autocomplete="off" /></label><button class="danger" @onclick='DeleteAsync' disabled="@(Busy || Deletion != "DELETE THIS ROOM")">Erase ended room</button></details> }
}
else { <p>Room management requires its owning host session. <a href="/account">Create or recover host access</a>.</p> }
@code {
    [Parameter] public string RoomId { get; set; } = "";
    RoomControl? Current; IJSObjectReference? Module; string Deletion = ""; string? LoadedRoom; bool EndConfirmed, NeedsReload;
    bool BothCrews => Current?.Players.Any(player => player.Role == "signal") == true && Current.Players.Any(player => player.Role == "engine");
    string JoinLink => Navigation.BaseUri.TrimEnd('/') + "/room/" + RoomId + "?invite=" + Current?.Invitation;
    protected override async Task OnParametersSetAsync() { if (LoadedRoom != RoomId) { LoadedRoom = RoomId; Current = null; EndConfirmed = false; Deletion = ""; } if (Busy) { NeedsReload = true; return; } await RunAsync(async () => { Apply(await Api.ControlAsync(RoomId, Lifetime.Token)); Watch(ReloadAsync, () => Current?.Room.Status == "finished"); }); }
    protected override async Task OnAfterRenderAsync(bool first) { if (first) { try { Module = await Javascript.InvokeAsync<IJSObjectReference>("import", "/assets/device.js"); } catch (JSException) { Status = "Clipboard access is unavailable. Copy the invitation from its visible field."; } StateHasChanged(); } if (NeedsReload && !Busy) { NeedsReload = false; await RunAsync(async () => { await ReloadAsync(); Watch(ReloadAsync, () => Current?.Room.Status == "finished"); }); StateHasChanged(); } }
    void Apply(RoomControl incoming) { if (incoming.Room.Id != RoomId) return; if (Current is null || incoming.Room.Id != Current.Room.Id || incoming.Room.Revision >= Current.Room.Revision) { Current = incoming; ObserveClock(incoming.Room); } }
    async Task ReloadAsync() => Apply(await Api.ControlAsync(RoomId, Lifetime.Token));
    Task RefreshAsync() => RunAsync(ReloadAsync);
    Task CommandAsync(string type) => RunAsync(async () => { var requestedRoom = RoomId; var result = await Api.HostAsync(requestedRoom, type); if (requestedRoom != RoomId) return; Apply(result); Status = "Host control applied to the real room."; EndConfirmed = false; });
    Task KickAsync(string id) => RunAsync(async () => { var requestedRoom = RoomId; var result = await Api.HostAsync(requestedRoom, "kick", id); if (requestedRoom != RoomId) return; Apply(result); Status = "Player removed; their capability can no longer read or change this room."; });
    Task CopyAsync() => RunAsync(async () => { if (Module is not null) Status = await Module.InvokeAsync<bool>("copy", JoinLink) ? "Room invitation copied." : "Copy the invitation from its visible field."; });
    Task DeleteAsync() => RunAsync(async () => { await Api.DeleteRoomAsync(RoomId, Deletion); Navigation.NavigateTo("/host"); });
    protected override async ValueTask DisposeBrowserAsync() { if (Module is not null) await Module.DisposeAsync(); }
}

