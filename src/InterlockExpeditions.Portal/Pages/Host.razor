@page "/host"
@inherits ExpeditionPage
@inject NavigationManager Navigation
<PageTitle>Host a ready adventure — Interlock Expeditions</PageTitle>
<p class="eyebrow">Expedition host</p><h1>Start with a ready story.</h1><p>Choose an episode, open a room and invite the other crew. The players receive their own cards when you start.</p>
@if (Status.Length > 0) { <p class="status @(HasError ? "error" : "")" role="status">@Status</p> }
@if (Loaded && Account.Account is null) { <section class="panel"><h2>Keep your controls in a free host account</h2><p>Create a display alias and save a private recovery key. Crew members will join as guests.</p><a class="button primary" href="/account">Create or recover host account</a></section> }
else if (Account.Account is not null)
{
    <div class="split"><section class="panel"><h2>Create a room</h2><fieldset disabled="@Busy"><label>Authored episode<select @bind="EpisodeId" @bind:after="EpisodeChanged">@foreach (var episode in Episodes) { <option value="@episode.Id">@episode.Title</option> }</select></label><label>Room title<input @bind="Title" maxlength="120" /></label><label>Room clock in minutes<input type="number" @bind="Minutes" min="5" max="90" /></label><p class="small">Free: two active rooms, up to six devices per room. One or more players on each of two crews. Longer clocks are useful for first-time players.</p><button class="primary" @onclick="CreateAsync" disabled="@(EpisodeId.Length == 0 || string.IsNullOrWhiteSpace(Title))">Create this real room</button></fieldset></section><section class="panel"><h2>Your rooms</h2><button @onclick="RefreshAsync" disabled="@Busy">Refresh room list</button><div class="room-list">@if (Rooms.Count == 0) { <p>No rooms have been created by this account.</p> }@foreach (var room in Rooms) { <article><div class="row"><h3>@room.Title</h3><span class="badge">@room.Status</span></div><p class="small">@room.EpisodeId · station @Math.Min(room.StageIndex + 1, 6) of 6 · @room.Mistakes mistakes</p><a class="button" href="@("/control/" + room.Id)">Open host controls</a></article> }</div></section></div>
}
@code {
    [SupplyParameterFromQuery(Name = "episode")] public string? RequestedEpisode { get; set; }
    AccountResult Account = new(); List<Episode> Episodes = []; List<Room> Rooms = []; string EpisodeId = "", Title = ""; int Minutes = 20; bool Loaded;
    protected override Task OnInitializedAsync() => RunAsync(async () => { Account = await Api.AccountAsync(); Episodes = (await Api.EpisodesAsync()).Episodes; EpisodeId = Episodes.FirstOrDefault(item => item.Id == RequestedEpisode)?.Id ?? Episodes.FirstOrDefault()?.Id ?? ""; EpisodeChanged(); if (Account.Account is not null) Rooms = (await Api.RoomsAsync()).Rooms; Loaded = true; });
    void EpisodeChanged() { var episode = Episodes.FirstOrDefault(item => item.Id == EpisodeId); if (episode is not null) { Title = episode.Title + " — crew room"; Minutes = episode.Minutes; } }
    Task CreateAsync() => RunAsync(async () => { var result = await Api.CreateRoomAsync(EpisodeId, Title, Minutes); Navigation.NavigateTo("/control/" + result.Room.Id); });
    Task RefreshAsync() => RunAsync(async () => Rooms = (await Api.RoomsAsync()).Rooms);
}
