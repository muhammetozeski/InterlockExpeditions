@page "/host"
@inherits ExpeditionPage
@inject NavigationManager Navigation
<PageTitle>Host a ready adventure — Interlock Expeditions</PageTitle>
<h1>Host a room</h1><p>Choose a story and invite the other crew.</p>
@if (Status.Length > 0) { <p class="status @(HasError ? "error" : "")" role="status">@Status</p> }
@if (Loaded && Account.Account is null) { <section class="panel"><h2>Sign in to host</h2><p>Guests join by invitation and do not need an account.</p><a class="button primary" href="@("account?episode=" + Uri.EscapeDataString(EpisodeId))">Create or recover account</a></section> }
else if (Account.Account is not null)
{
    <div class="split"><section class="panel"><h2>Create a room</h2><fieldset disabled="@Busy"><label>Story<select @bind="EpisodeId" @bind:after="EpisodeChanged">@foreach (var episode in Episodes) { <option value="@episode.Id">@episode.Title</option> }</select></label><label>Room name<input @bind="Title" maxlength="120" /></label><label>Time limit in minutes<input type="number" @bind="Minutes" min="5" max="90" /></label><p class="small">Your allowance: @(Account.Premium ? "12 active rooms and 12 devices per new room" : "2 active rooms and 6 devices per room").</p><button class="primary" @onclick="CreateAsync" disabled="@(EpisodeId.Length == 0 || string.IsNullOrWhiteSpace(Title))">Create room</button></fieldset></section><section class="panel"><h2>Your rooms</h2><button @onclick="RefreshAsync" disabled="@Busy">Refresh</button><div class="room-list">@if (Rooms.Count == 0) { <p>No rooms yet.</p> }@foreach (var room in Rooms) { <article><div class="row"><h3>@room.Title</h3><span class="badge">@room.Status</span></div><p class="small">@Math.Min(room.StageIndex + 1, 6) of 6 puzzles · @room.Mistakes mistakes</p><a class="button" href="@("control/" + room.Id)">Open room controls</a></article> }</div></section></div>
}
@code {
    [SupplyParameterFromQuery(Name = "episode")] public string? RequestedEpisode { get; set; }
    AccountResult Account = new(); List<Episode> Episodes = []; List<Room> Rooms = []; string EpisodeId = "", Title = ""; int Minutes = 20; bool Loaded;
    protected override Task OnInitializedAsync() => RunAsync(async () => { Account = await Api.AccountAsync(); Episodes = (await Api.EpisodesAsync()).Episodes; EpisodeId = Episodes.FirstOrDefault(item => item.Id == RequestedEpisode)?.Id ?? Episodes.FirstOrDefault()?.Id ?? ""; EpisodeChanged(); if (Account.Account is not null) Rooms = (await Api.RoomsAsync()).Rooms; Loaded = true; });
    void EpisodeChanged() { var episode = Episodes.FirstOrDefault(item => item.Id == EpisodeId); if (episode is not null) { Title = episode.Title + " — crew room"; Minutes = episode.Minutes; } }
    Task CreateAsync() => RunAsync(async () => { var result = await Api.CreateRoomAsync(EpisodeId, Title, Minutes); Navigation.NavigateTo("control/" + result.Room.Id); });
    Task RefreshAsync() => RunAsync(async () => Rooms = (await Api.RoomsAsync()).Rooms);
}
